#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const { buildKitzurYearCalendar, validateLeapOption } = require('../lib/kitzurYearCalendar');
const { getDefaultJewishYear } = require('../lib/yearCalendar');
const { writeKitzurCalendarPdf } = require('../lib/kitzurCalendarPdf');

function usage() {
  return [
    'Usage: node tools/buildKitzurCalendar [year] [options]',
    '',
    'Options:',
    '  --year <year>          Jewish year (for example, 5787)',
    '  --format <format>      pdf, csv, or both (default: both)',
    '  --output <path>        Output file, or directory when format is both',
    '  --leap-option <value>  A, B, or both (default: both)',
    '  --israel               Use the Israeli holiday cycle',
    '  --help                 Show this help'
  ].join('\n');
}

function parseArgs(argv) {
  const options = { format: 'both', israel: false, leapOption: 'both' };
  for (let index = 0; index < argv.length; index++) {
    const value = argv[index];
    if (value === '--help' || value === '-h') options.help = true;
    else if (value === '--israel') options.israel = true;
    else if (value === '--year') options.year = argv[++index];
    else if (value === '--format') options.format = argv[++index];
    else if (value === '--output') options.output = argv[++index];
    else if (value === '--leap-option') options.leapOption = argv[++index];
    else if (!value.startsWith('-') && options.year === undefined) options.year = value;
    else throw new Error(`Unknown argument: ${value}`);
  }
  if (!['pdf', 'csv', 'both'].includes(options.format)) {
    throw new Error('Format must be pdf, csv, or both.');
  }
  options.leapOption = validateLeapOption(options.leapOption);
  options.year = options.year || getDefaultJewishYear();
  return options;
}

function csvForCalendar(calendar) {
  return calendar.weeks.map((week) => {
    const cells = week.days.map((day) => day.learning.replace(/\n/g, ' / '));
    cells.push(week.note);
    return cells.map((cell) => `"${String(cell).replace(/"/g, '""')}"`).join(',');
  }).join('\n') + '\n';
}

function outputPaths(options, year) {
  const dataDir = path.join(__dirname, '..', 'data');
  if (options.format === 'both') {
    const directory = options.output ? path.resolve(options.output) : dataDir;
    return {
      csv: path.join(directory, `kitzur-calendar-${year}.csv`),
      pdf: path.join(directory, `kitzur-calendar-${year}.pdf`)
    };
  }
  return {
    [options.format]: options.output
      ? path.resolve(options.output)
      : path.join(dataDir, `kitzur-calendar-${year}.${options.format}`)
  };
}

async function main() {
  try {
    const options = parseArgs(process.argv.slice(2));
    if (options.help) return console.log(usage());
    const calendar = await buildKitzurYearCalendar(options.year, options);
    const paths = outputPaths(options, calendar.year);
    Object.values(paths).forEach((file) => fs.mkdirSync(path.dirname(file), { recursive: true }));
    if (paths.csv) fs.writeFileSync(paths.csv, csvForCalendar(calendar), 'utf8');
    if (paths.pdf) await writeKitzurCalendarPdf(calendar, paths.pdf);
    console.log(`Generated ${calendar.weeks.length} weeks (${calendar.start.toDateString()} – ${calendar.end.toDateString()})`);
    console.log(`Adar II track: ${calendar.leapOption}`);
    Object.values(paths).forEach((file) => console.log(file));
  } catch (error) {
    console.error(error.message);
    console.error(usage());
    process.exitCode = 1;
  }
}

if (require.main === module) main();

module.exports = { csvForCalendar, outputPaths, parseArgs };
